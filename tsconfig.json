{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["ui/**/*.ts", "vite.config.ts"]
}
