{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swaggy",
  "version": "0.1.0",
  "identifier": "dev.swaggy.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Swaggy",
      "width": 1440,
      "height": 940,
      "minWidth": 900,
      "minHeight": 600,
      "backgroundColor": "#f6f7f9"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "A thoughtful workspace for your APIs",
    "category": "DeveloperTool"
  }
}
